# Virtual environment (see README step 2)
.venv/

# Environment Variables & Secrets
.env
*.env

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.parquet
results/oof/*.parquet
results/agent_logs/*.json
# Fold models and checkpoints from the neural models (python run.py cnn) and the robustness study.
results/models/
# Completed experiment checkpoints are local caches; published OOF and tables are separate.
/results/runs/

# The raw files are committed gzipped (check-raw unpacks them); built data is not committed.
/data/raw/*
!/data/raw/*.csv.gz
/data/interim/
/data/processed/
# Feature caches of attacked clients written by src/eval/adversarial.py.
data/processed/attacked_*
/data/*.csv

# macOS
.DS_Store
