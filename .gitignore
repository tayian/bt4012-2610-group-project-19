# Ignore jerryDevIgnore folder
jerryDevIgnore/

# Ignore venv
BT4012ProjectEnv/

# Environment Variables & Secrets
.env
*.env

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.parquet
# The fake stub tables are tracked (python run.py stubs).
!/data/stubs/**/*.parquet
results/oof/*.parquet
results/agent_logs/*.json
# Fold models and checkpoints from the neural models (python run.py cnn) and the robustness study.
results/models/
# Completed experiment checkpoints are local caches; published OOF and tables are separate.
/results/runs/

# Data is never committed: it comes in the steg_project_data folder (see README step 3).
# Only data/splits/, data/corpus/ and data/stubs/ are tracked.
/data/raw/*
!/data/raw/.gitkeep
/data/interim/
/data/processed/
# Feature caches of attacked clients written by src/eval/adversarial.py.
data/processed/attacked_*
/data/*.csv

# macOS
.DS_Store
