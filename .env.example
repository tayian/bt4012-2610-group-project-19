# ==============================================================================
# Environment Configuration (.env)
# Copy this file to .env and fill in your private API keys.
# DO NOT commit your actual .env file to Git!
# ==============================================================================

# Primary LLM Provider (Google Gemini API - Pro Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative LLM Providers (Optional for comparative benchmark runs)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Random Seed for Reproducibility
RANDOM_SEED=4012
